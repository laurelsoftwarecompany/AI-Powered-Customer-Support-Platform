# Copy to .env for `docker compose up`. Every value has a working default,
# so the stack runs with no edits at all (AI in offline "mock" mode).
# .env is git-ignored - never commit real keys.

# ---- Database ----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support

# ---- Auth --------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI provider -------------------------------------------------
# mock   -> no API key, deterministic answers, works offline
# gemini -> free tier at aistudio.google.com (recommended for the demo)
# also supported: groq | openrouter | openai | anthropic
AI_PROVIDER=mock
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- Web dashboard ----------------------------------------------
# The API URL the *browser* calls (not the compose-internal hostname).
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
