# ==================================================================
# AI Customer Support Platform - backend environment
# Copy to .env and adjust. Every value has a safe default, so the
# backend also runs with no .env at all (SQLite + mock AI).
# ==================================================================

# ---- Database -----------------------------------------------------
# Zero-setup local dev (SQLite file in the backend folder):
DATABASE_URL=sqlite:///./customer_support.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/customer_support

# ---- Auth --------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- AI provider ---------------------------------------------------
# mock       -> no API key, deterministic canned answers (dev / demo)
# gemini     -> set GEMINI_API_KEY   (free tier at aistudio.google.com)
# groq       -> set GROQ_API_KEY     (free tier at console.groq.com)
# openrouter -> set OPENROUTER_API_KEY
# openai     -> set OPENAI_API_KEY
# anthropic  -> set ANTHROPIC_API_KEY
AI_PROVIDER=mock
AI_MODEL=                      # blank -> per-provider default
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- RAG --------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5    # fastembed, local, 384-dim
RAG_TOP_K=4
RAG_MIN_SCORE=0.5             # drop retrieved chunks below this cosine score
CONFIDENCE_THRESHOLD=0.70     # AI hands off to a human below this confidence

# ---- CORS (comma-separated) -----------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
